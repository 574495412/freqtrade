+CALLBACKS = (
+    "bot_loop_start",
+    "confirm_trade_entry",
+    "custom_exit",
+    "adjust_trade_position",
+    "order_filled",
+    "custom_stake_amount",
+    "leverage",
+    "confirm_trade_exit",
